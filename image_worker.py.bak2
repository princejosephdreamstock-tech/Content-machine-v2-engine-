import os
import json
import time
import requests
from engine_common import get_db, get_channel_config, get_default, push_job, push_failed_job, redis_headers, REDIS_URL

STATE_FILE = os.path.expanduser("~/engine_v2/.q_image_lastid")
IMAGE_DIR = os.path.expanduser("~/pipeline_images_v2")
os.makedirs(IMAGE_DIR, exist_ok=True)

_nvidia_key_idx = 0


def get_nvidia_key(attempt=0):
    keys_raw = get_default("nvidia_api_keys", "[]")
    keys = json.loads(keys_raw) if isinstance(keys_raw, str) else keys_raw
    if not keys:
        raise ValueError("No nvidia_api_keys configured in system_defaults")
    return keys[attempt % len(keys)]


def read_new_jobs():
    last_id = "0"
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE) as f:
            last_id = f.read().strip() or "0"
    r = requests.get(f"{REDIS_URL}/xrange/q.image/({last_id}/+", headers=redis_headers, timeout=30)
    return r.json().get("result", []), last_id


def save_last_id(entry_id):
    with open(STATE_FILE, "w") as f:
        f.write(entry_id)


def generate_flux_image(prompt, out_path):
    global _nvidia_key_idx
    h = {"Authorization": f"Bearer {get_nvidia_key(_nvidia_key_idx)}", "Accept": "application/json"}
    payload = {
        "prompt": prompt, "mode": "base", "cfg_scale": 3.5,
        "width": 1280, "height": 768, "seed": 0, "steps": 50,
    }
    resp = requests.post(
        "https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-dev",
        headers=h, json=payload, timeout=120,
    )
    if resp.status_code == 429:
        _nvidia_key_idx += 1
        raise Exception(f"NVIDIA rate limited (429): {resp.text[:200]}")
    resp.raise_for_status()
    data = resp.json()
    b64_img = data["artifacts"][0]["base64"]
    import base64
    with open(out_path, "wb") as f:
        f.write(base64.b64decode(b64_img))


def generate_image(prompt, out_path, channel_id):
    """Provider comes from config; today only flux is implemented,
    but adding a second provider means adding one branch here and
    setting image_provider in a channel's config_json or system_defaults —
    never a new file."""
    config = get_channel_config(channel_id)
    provider = config["image_provider"]
    if provider == "flux":
        generate_flux_image(prompt, out_path)
    else:
        raise ValueError(f"Unknown image_provider={provider!r}")


def process_job(run_id, channel_id):
    conn = get_db()
    cur = conn.cursor()
    cur.execute("SELECT script_json FROM runs WHERE run_id=%s", (run_id,))
    row = cur.fetchone()
    sections = row[0]["sections"]
    # NOTE: single-image-per-run behavior preserved from the stub (uses the
    # hook section's image_prompt). Per-section image generation is not yet
    # built -- flagged as a gap, not implemented here.
    image_prompt = sections[0]["image_prompt"]

    out_path = os.path.join(IMAGE_DIR, f"{run_id}_1.png")
    generate_image(image_prompt, out_path, channel_id)

    cur.execute(
        "UPDATE runs SET status='ASSETS_GENERATED', updated_at=now() WHERE run_id=%s",
        (run_id,),
    )
    conn.commit()
    cur.close()
    conn.close()
    push_job("q.assembly", run_id, channel_id)
    print(f"[image_worker] {channel_id} run {run_id} -> ASSETS_GENERATED")


def main_loop():
    while True:
        entries, last_id = read_new_jobs()
        for entry_id, fields in entries:
            job = {}
            try:
                field_dict = dict(zip(fields[::2], fields[1::2]))
                job = json.loads(field_dict.get("job", "{}"))
                run_id = job["run_id"]
                channel_id = job["channel_id"]
                process_job(run_id, channel_id)
            except Exception as e:
                push_failed_job(job.get("run_id"), job.get("channel_id"), "image", e, payload=fields)
            save_last_id(entry_id)
        time.sleep(5)


if __name__ == "__main__":
    main_loop()
